# Firebase Configuration (REQUIRED)
FIREBASE_SERVICE_ACCOUNT=/path/to/serviceAccountKey.json
FIREBASE_RTDB_URL=https://your-project.firebaseio.com

# Operational Settings
STATUS_PUBLISH_INTERVAL=0.2     # Status update interval in seconds (200ms)

# Logging
LOG_LEVEL=INFO                  # DEBUG, INFO, WARNING, ERROR

# NOTE: Device ID is auto-generated from MAC address
# NOTE: All robot configuration (IP, port, credentials, simulation mode) 
#       is now loaded from Firestore dynamically when the mobile app
#       selects a robot by setting /devices/{deviceId}/selectedRobotId

