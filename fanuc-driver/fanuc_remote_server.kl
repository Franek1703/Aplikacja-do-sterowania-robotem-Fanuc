-- Description:         Manufacturing Apps
--                      Development Kit (FANUC_REMOTE) 
--                      Driver for FANUC robots.
PROGRAM FANUC_SVR
%STACKSIZE = 4000
%NOLOCKGROUP
%NOPAUSE = ERROR + COMMAND + TPENABLE
%ALPHABETIZE
%COMMENT = 'FANUC_REMOTE SERVER V0.0.1'

VAR
    comm_file:          FILE
    status:             INTEGER
    entry:              INTEGER
    cmd:                STRING[254]
    resp:               STRING[254]
    keep_conn:          BOOLEAN
    uframe_str:         STRING[1]
    tool_str:           STRING[1]

    -- Global state variables for tool/user/coord selection
    g_tool_num:         INTEGER
    g_uframe_num:       INTEGER
    g_coord_type:       INTEGER  -- 0=WORLD, 1=USER, 2=TOOL

    -- Global jogging state variables
    jog_active:         ARRAY[6] OF BOOLEAN
    jog_dir:            ARRAY[6] OF BOOLEAN
    jog_speed:          INTEGER
    jog_step_lin:       REAL
    jog_step_rot:       REAL
    jog_interval:       INTEGER
    jog_pr:             XYZWPR
    multi_axis:         BOOLEAN
    active_axest:       INTEGER

    -- Time in ms condition handlera
    cont_timer:         INTEGER

CONST
    SERVER_TAG = 8
    PORT_NUMBER = 18735
    UFRAMENUM = 8
    TOOLNUM = 8

-- Include routines
%INCLUDE fanuc_remote_context
%INCLUDE fanuc_remote_utils
%INCLUDE fanuc_remote_comm
%INCLUDE fanuc_remote_jog
%INCLUDE fanuc_remote_cmd

BEGIN -- Begin main program
    -- clear screen
    TP_CLS
    WRITE('FANUC_REMOTE SERVER started.', CR)

    -- Initialize global state variables
    g_tool_num   = TOOLNUM
    g_uframe_num = UFRAMENUM
    g_coord_type = 0  -- Default to WORLD

    -- Initialize jog module
    JOG_INIT

    -- set userframe and toolframe
    SET_VAR(entry, '*SYSTEM*', '$MNUFRAMENUM[1]', g_uframe_num, status)
    SET_VAR(entry, '*SYSTEM*', '$MNUTOOLNUM[1]',  g_tool_num,   status)

    -- update $UFRAME and $UTOOL
    CNV_INT_STR(UFRAMENUM, 1, 0, uframe_str)
    CNV_INT_STR(TOOLNUM,   1, 0, tool_str)
    GET_VAR(entry, '*SYSTEM*', '$MNUFRAME[1, ' + uframe_str + ']', $GROUP[1].$UFRAME, status)
    GET_VAR(entry, '*SYSTEM*', '$MNUTOOL[1, '  + tool_str   + ']', $GROUP[1].$UTOOL,  status)

    -- === Jog "tick" via CONNECT TIMER + CONDITION handler ===
    cont_timer = 0
    CONNECT TIMER TO cont_timer       -- licznik rośnie co $SCR.$COND_TIME ms :contentReference[oaicite:1]{index=1}

    CONDITION[10]:
        WHEN cont_timer >= jog_interval DO
            JOG_TICK
            cont_timer = 0
            ENABLE CONDITION[10]      -- po wyzwoleniu handler jest wyłączony; ponownie go włączamy :contentReference[oaicite:2]{index=2}
    ENDCONDITION
    ENABLE CONDITION[10]

    -- === Główna pętla serwera ===
    WHILE TRUE DO
        -- open
        OPEN_COMM(comm_file, SERVER_TAG, PORT_NUMBER)

        keep_conn = TRUE
        WHILE keep_conn DO
            READ comm_file(cmd)
            IF UNINIT(cmd) THEN
                keep_conn = FALSE
            ELSE
                keep_conn = HANDLE_CMD(cmd, resp)

                IF keep_conn THEN
                    WRITE comm_file (resp)
                ELSE
                    WRITE comm_file (resp)
                    READ comm_file(cmd::0)
                ENDIF
            ENDIF
        ENDWHILE

        -- disconnect
        CLOSE_COMM(comm_file, SERVER_TAG)
    ENDWHILE -- main listening loop

    WRITE('FANUC_REMOTE SERVER finished.', CR)
END FANUC_SVR
