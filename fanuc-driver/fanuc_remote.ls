/PROG  FANUC_REMOTE
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "FANUC_REMOTE MAIN";
PROG_SIZE	= 176;
CREATE		= DATE 22-01-19  TIME 10:20:54;
MODIFIED	= DATE 08-01-01  TIME 01:55:22;
FILE_NAME	= ;
VERSION		= 0;
LINE_COUNT	= 2;
MEMORY_SIZE	= 556;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 4000,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 7;
DEFAULT_GROUP	= 1,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
/MN
   1:  RUN FANUC_SVR ;
   2:  RUN FANUC_LOG ;
/POS
/END
