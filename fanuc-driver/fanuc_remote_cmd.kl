    IF DOUT[dout_num] = TRUE THEN
        DOUT[dout_num] = TRUE
        resp = '0:1'
        RETURN(resp)
    ENDIF

    IF DOUT[dout_num] = FALSE THEN
        DOUT[dout_num] = FALSE
        resp = '0:0'
        RETURN(resp)
    ENDIF

    resp = '1:wrong-dout-value'
    RETURN(resp)

END GET_DOUT

ROUTINE SET_DOUT(cmd: STRING): STRING
----------------------------------------------------
-- Function: Sets digital out.
-- cmd string should follow the below format:
-- 'setdout:n:value'
-- n: a 5 digit number with leading zeros
-- value: 'true' or 'false' (lowercase)
----------------------------------------------------
-- Arguments:
--      cmd [IN]:           command string.
----------------------------------------------------
-- Return value: response string.
----------------------------------------------------
VAR
    dout_num:            INTEGER
    dout_val:            STRING[8]
BEGIN
    -- Get DOUT number
    CNV_STR_INT(SUB_STR(cmd, 9, 5), dout_num)

    -- Get DOUT value
    dout_val = SUB_STR(cmd, 15, STR_LEN(cmd) - 14)

    IF dout_val = 'true' THEN
        DOUT[dout_num] = TRUE
        resp = '0:success'
        RETURN(resp)
    ENDIF

    IF dout_val = 'false' THEN
        DOUT[dout_num] = FALSE
        resp = '0:success'
        RETURN(resp)
    ENDIF

    resp = '1:wrong-dout-value'
    RETURN(resp)

END SET_DOUT

ROUTINE SET_SYS_VAR(cmd: STRING): STRING
----------------------------------------------------
-- Function: Sets System Variable.
-- cmd string should follow the below format:
-- 'setsysvar:n:value'
-- n: a string of the system variable to change
-- value: 'T' or 'F' (T/F)
----------------------------------------------------
-- Arguments:
--      cmd [IN]:           command string.
----------------------------------------------------
-- Return value: response string.
----------------------------------------------------
VAR
	resp:           	STRING[254]
	sys_var:            STRING[254]
	sys_val:            STRING[8]
BEGIN
	-- Get System Variable string
	sys_var = SUB_STR(cmd, 11, (STR_LEN(cmd) - 12))

	-- Get System Variable value
	sys_val = SUB_STR(cmd, 10 + STR_LEN(sys_var) + 2, 1)

	IF sys_val = 'T' THEN
		SET_VAR(entry, '*SYSTEM*', sys_var, TRUE, status)
		resp = '0:success'
		RETURN(resp)
	ENDIF

	IF sys_val = 'F' THEN
		SET_VAR(entry, '*SYSTEM*', sys_var, FALSE, status)
		resp = '0:success'
		RETURN(resp)
	ENDIF

	resp = '1:wrong-sys_var-value'
	RETURN(resp)

END SET_SYS_VAR


ROUTINE SET_TOOL(cmd: STRING): STRING
----------------------------------------------------
-- Function: Set tool number (UTOOL_NUM)
----------------------------------------------------
-- Arguments:
--      cmd [IN]:           command string.
----------------------------------------------------
-- Return value: response string.
----------------------------------------------------
VAR
    sub_cmd:         STRING[30]
    args:            STRING[200]
    tool_num:        INTEGER
    status:          INTEGER
    entry:           INTEGER
BEGIN
    -- Parse command
    -- Format: set_tool <tool_num>
    SPLIT_CMD(cmd, sub_cmd, args)
    
    -- Convert to integer
    CNV_STR_INT(args, tool_num)
    
    -- Update global state variable
    g_tool_num = tool_num
    
    -- Set R[84] for TP program
    SET_INT_REG(84, tool_num, status)
    IF status <> 0 THEN
        RETURN('1:cannot-set-r84')
    ENDIF
    
    -- Run TP program to set UTOOL_NUM
    CALL_PROG('SET_UTOOL_TP', status)
    IF status <> 0 THEN
        RETURN('1:cannot-run-set-utool-tp')
    ENDIF
    
    -- Apply kinematic context
    APL_KIN_CTX
    
    -- Log success
    LOG_INFO('Tool number set to ' + args)
    
    RETURN('0:tool-set-success')
END SET_TOOL


ROUTINE SET_USER(cmd: STRING): STRING
----------------------------------------------------
-- Function: Set user frame number (UFRAME_NUM)
----------------------------------------------------
-- Arguments:
--      cmd [IN]:           command string.
----------------------------------------------------
-- Return value: response string.
----------------------------------------------------
VAR
    sub_cmd:         STRING[30]
    args:            STRING[200]
    user_num:        INTEGER
    status:          INTEGER
    entry:           INTEGER
BEGIN
    -- Parse command
    -- Format: set_user <user_num>
    SPLIT_CMD(cmd, sub_cmd, args)
    
    -- Convert to integer
    CNV_STR_INT(args, user_num)
    
    -- Update global state variable
    g_uframe_num = user_num
    
    -- Set R[85] for TP program
    SET_INT_REG(85, user_num, status)
    IF status <> 0 THEN
        RETURN('1:cannot-set-r85')
    ENDIF
    
    -- Run TP program to set UFRAME_NUM
    CALL_PROG('SET_UFRAME_TP', status)
    IF status <> 0 THEN
        RETURN('1:cannot-run-set-uframe-tp')
    ENDIF
    
    -- Apply kinematic context
    APL_KIN_CTX
    
    -- Log success
    LOG_INFO('User frame number set to ' + args)
    
    RETURN('0:user-set-success')
END SET_USER


ROUTINE SET_COORD(cmd: STRING): STRING
----------------------------------------------------
-- Function: Set coordinate system (WORLD/USER/TOOL)
----------------------------------------------------
-- Arguments:
--      cmd [IN]:           command string.
----------------------------------------------------
-- Return value: response string.
----------------------------------------------------
VAR
    sub_cmd:         STRING[30]
    args:            STRING[200]
    entry:           INTEGER
    status:          INTEGER
BEGIN
    -- Parse command
    -- Format: set_coord <WORLD|USER|TOOL>
    SPLIT_CMD(cmd, sub_cmd, args)
    
    -- Convert string to coord type
    IF args = 'WORLD' THEN
        g_coord_type = 0
    ELSE 
    	IF args = 'USER' THEN
    		 g_coord_type = 1
    	ELSE 
    		IF args = 'TOOL' THEN
        		g_coord_type = 2
    		ELSE
        		RETURN('1:invalid-coord-type')
    		ENDIF
    	ENDIF	
    ENDIF
    
    -- Apply kinematic context
    APL_KIN_CTX
    
    -- Log success
    LOG_INFO('Coordinate system set to ' + args)
    
    RETURN('0:coord-set-success')
END SET_COORD


ROUTINE GET_TOOL(cmd: STRING): STRING
----------------------------------------------------
-- Function: Get current tool number (UTOOL_NUM)
----------------------------------------------------
-- Arguments:
--      cmd [IN]:           command string.
----------------------------------------------------
-- Return value: response string.
----------------------------------------------------
VAR
    resp:            STRING[254]
    val_str:         STRING[10]
BEGIN
    -- Convert tool number to string
    CNV_INT_STR(g_tool_num, 0, 0, val_str)
    
    -- Format response
    resp = '0:' + val_str
    
    RETURN(resp)
END GET_TOOL


ROUTINE GET_USER(cmd: STRING): STRING
----------------------------------------------------
-- Function: Get current user frame number (UFRAME_NUM)
----------------------------------------------------
-- Arguments:
--      cmd [IN]:           command string.
----------------------------------------------------
-- Return value: response string.
----------------------------------------------------
VAR
    resp:            STRING[254]
    val_str:         STRING[10]
BEGIN
    -- Convert user frame number to string
    CNV_INT_STR(g_uframe_num, 0, 0, val_str)
    
    -- Format response
    resp = '0:' + val_str
    
    RETURN(resp)
END GET_USER


ROUTINE GET_COORD(cmd: STRING): STRING
----------------------------------------------------
-- Function: Get current coordinate system
----------------------------------------------------
-- Arguments:
--      cmd [IN]:           command string.
----------------------------------------------------
-- Return value: response string.
----------------------------------------------------
VAR
    resp:            STRING[254]
BEGIN
    -- Convert coord type to string
    SELECT g_coord_type OF
        CASE (0):
            resp = '0:WORLD'
        CASE (1):
            resp = '0:USER'
        CASE (2):
            resp = '0:TOOL'
        ELSE:
            resp = '1:unknown-coord-type'
    ENDSELECT
    
    RETURN(resp)
END GET_COORD

-- Helper function to split arguments by space
ROUTINE SPLIT_ARGS(args: STRING; args_array: ARRAY OF STRING): INTEGER
VAR
    i: INTEGER
    j: INTEGER
    start_idx: INTEGER
    len: INTEGER
    arg_count: INTEGER
BEGIN
    len = STR_LEN(args)
    start_idx = 1
    arg_count = 0
    j = 1
    
    FOR i = 1 TO len DO
        IF (SUB_STR(args, i, 1) = ' ') OR (i = len) THEN
            -- End of argument found
            IF i = len AND SUB_STR(args, i, 1) <> ' ' THEN
                -- Include the last character if it's not a space
                args_array[arg_count+1] = SUB_STR(args, start_idx, j)
                arg_count = arg_count + 1
            ELSE
            	IF j > 1 THEN
                	args_array[arg_count+1] = SUB_STR(args, start_idx, j-1)
                	arg_count = arg_count + 1
            	ENDIF
            ENDIF
            
            -- Reset for next argument
            start_idx = i + 1
            j = 1
        ELSE
            j = j + 1
        ENDIF
    ENDFOR
    
    RETURN(arg_count)
END SPLIT_ARGS

ROUTINE JOG_START_H(cmd: STRING): STRING
----------------------------------------------------
-- Function: Handle JOG_START command
-- Format: JOG_START <AXIS> <DIR> [SPEED] [STEP]
----------------------------------------------------
-- Arguments:
--      cmd [IN]: Command string
----------------------------------------------------
-- Return value: response string
----------------------------------------------------
VAR
    sub_cmd:         STRING[30]
    args:            STRING[200]
    args_array:      ARRAY[4] OF STRING[20]
    num_args:        INTEGER
    axis_name:       STRING[1]
    axis_idx:        INTEGER
    dir_str:         STRING[1]
    direction:       BOOLEAN
    speed:           INTEGER
    step:            REAL
    i:               INTEGER
    has_speed:       BOOLEAN
    has_step:        BOOLEAN
BEGIN
    -- Parse command
    -- Format: JOG_START <AXIS> <DIR> [SPEED] [STEP]
    SPLIT_CMD(cmd, sub_cmd, args)
    
    -- Split arguments by space
    num_args = SPLIT_ARGS(args, args_array)
    
    -- Need at least axis and direction
    IF num_args < 2 THEN
        RETURN('1:ERR INVALID_ARGS')
    ENDIF
    
    -- Parse axis
    axis_name = args_array[1]
    axis_idx = AXIS2IDX(axis_name)
    IF axis_idx = 0 THEN
        RETURN('1:ERR INVALID_AXIS')
    ENDIF
    
    -- Parse direction
    dir_str = args_array[2]
    IF dir_str = '+' THEN
        direction = TRUE
    ELSE
    	IF dir_str = '-' THEN
        	direction = FALSE
   	 ELSE
        	RETURN('1:ERR INVALID_DIRECTION')
    	ENDIF
    ENDIF
    
    -- Parse optional speed
    has_speed = FALSE
    IF num_args >= 3 THEN
        CNV_STR_INT(args_array[3], speed)
        has_speed = TRUE
    ENDIF
    
    -- Parse optional step
    has_step = FALSE
    IF num_args >= 4 THEN
        CNV_STR_REAL(args_array[4], step)
        has_step = TRUE
    ENDIF
    
    -- Call JOG_START with parsed parameters
    IF has_speed AND has_step THEN
        RETURN(JOG_START(axis_idx, direction, speed, step, step*2))
    ELSE
    	IF has_speed THEN
        	RETURN(JOG_START(axis_idx, direction, speed, 0, 0))
   	 ELSE
        	RETURN(JOG_START(axis_idx, direction, 0, 0, 0))
    	ENDIF
    ENDIF
END JOG_START_H


ROUTINE JOG_STOP_H(cmd: STRING): STRING
----------------------------------------------------
-- Function: Handle JOG_STOP command
-- Format: JOG_STOP <AXIS>
----------------------------------------------------
-- Arguments:
--      cmd [IN]: Command string
----------------------------------------------------
-- Return value: response string
----------------------------------------------------
VAR
    sub_cmd:         STRING[30]
    args:            STRING[200]
    axis_name:       STRING[1]
    axis_idx:        INTEGER
BEGIN
    -- Parse command
    -- Format: JOG_STOP <AXIS>
    SPLIT_CMD(cmd, sub_cmd, args)
    
    -- Parse axis
    axis_name = args
    axis_idx = AXIS2IDX(axis_name)
    IF axis_idx = 0 THEN
        RETURN('1:ERR INVALID_AXIS')
    ENDIF
    
    -- Call JOG_STOP with parsed axis
    RETURN(JOG_STOP(axis_idx))
END JOG_STOP_H

-- Helper function to convert string to integer
ROUTINE S_TO_I(str: STRING): INTEGER
VAR
    val: INTEGER
BEGIN
    CNV_STR_INT(str, val)
    RETURN(val)
END S_TO_I


-- Helper function to convert string to real
ROUTINE S_TO_R(str: STRING): REAL
VAR
    val: REAL
BEGIN
    CNV_STR_REAL(str, val)
    RETURN(val)
END S_TO_R


ROUTINE HANDLE_CMD(cmd: STRING;
                   resp: STRING) : BOOLEAN
----------------------------------------------------
-- Function: Handles commands.
----------------------------------------------------
-- Arguments:
--      cmd [IN]:           command string.
--      resp [IN, OUT]:     response string.
----------------------------------------------------
-- Return value: BOOLEAN keep or close connection.
----------------------------------------------------
BEGIN
    IF cmd = 'exit' THEN
        resp = '0:success'
        RETURN(FALSE)
    ENDIF

    -- curpos
    IF SUB_STR(cmd, 1, 6) = 'curpos' THEN
        resp = GET_CURPOS(cmd)
        RETURN(TRUE)
    ENDIF

    -- curjpos
    IF SUB_STR(cmd, 1, 7) = 'curjpos' THEN
        resp = GET_CURJPOS(cmd)
        RETURN(TRUE)
    ENDIF

    -- ins_pwr
    IF SUB_STR(cmd, 1, 7) = 'ins_pwr' THEN
        resp = GET_INS_PWR(cmd)
        RETURN(TRUE)
    ENDIF

    -- movej
    IF SUB_STR(cmd, 1, 5) = 'movej' THEN
        resp = MOVEJ(cmd)
        RETURN(TRUE)
    ENDIF

    -- movep
    IF SUB_STR(cmd, 1, 5) = 'movep' THEN
        resp = MOVEP(cmd)
        RETURN(TRUE)
    ENDIF

    -- fanuccall: call external TP program
    IF SUB_STR(cmd, 1, 10) = 'fanuccall' THEN
        resp = REMOTECALL(cmd)
        RETURN(TRUE)
    ENDIF

    -- setrdo: set Robot Digital Output
    IF SUB_STR(cmd, 1, 6) = 'setrdo' THEN
        resp = SET_RDO(cmd)
        RETURN(TRUE)
    ENDIF

    -- getrdo: get Robot Digital Output
    IF SUB_STR(cmd, 1, 6) = 'getrdo' THEN
        resp = GET_RDO(cmd)
        RETURN(TRUE)
    ENDIF

     -- setdout: set Digital Output
    IF SUB_STR(cmd, 1, 7) = 'setdout' THEN
        resp = SET_DOUT(cmd)
        RETURN(TRUE)
    ENDIF

    -- getdout: get Digital Output
    IF SUB_STR(cmd, 1, 7) = 'getdout' THEN
        resp = GET_DOUT(cmd)
        RETURN(TRUE)
    ENDIF

    -- setsysvar: set System Variable
	IF SUB_STR(cmd, 1, 9) = 'setsysvar' THEN
        resp = SET_SYS_VAR(cmd)
        RETURN(TRUE)
	ENDIF

    -- set_tool: set tool number
    IF SUB_STR(cmd, 1, 8) = 'set_tool' THEN
        resp = SET_TOOL(cmd)
        RETURN(TRUE)
    ENDIF

    -- set_user: set user frame number
    IF SUB_STR(cmd, 1, 8) = 'set_user' THEN
        resp = SET_USER(cmd)
        RETURN(TRUE)
    ENDIF

    -- set_coord: set coordinate system (WORLD/USER/TOOL)
    IF SUB_STR(cmd, 1, 9) = 'set_coord' THEN
        resp = SET_COORD(cmd)
        RETURN(TRUE)
    ENDIF

    -- get_tool: get current tool number
    IF SUB_STR(cmd, 1, 8) = 'get_tool' THEN
        resp = GET_TOOL(cmd)
        RETURN(TRUE)
    ENDIF

    -- get_user: get current user frame number
    IF SUB_STR(cmd, 1, 8) = 'get_user' THEN
        resp = GET_USER(cmd)
        RETURN(TRUE)
    ENDIF

    -- get_coord: get current coordinate system
    IF SUB_STR(cmd, 1, 9) = 'get_coord' THEN
        resp = GET_COORD(cmd)
        RETURN(TRUE)
    ENDIF
    
    -- jog_start: start continuous jogging of an axis
    IF SUB_STR(cmd, 1, 9) = 'jog_start' THEN
        resp = JOG_START_H(cmd)
        RETURN(TRUE)
    ENDIF
    
    -- jog_stop: stop jogging of a specific axis
    IF SUB_STR(cmd, 1, 8) = 'jog_stop' THEN
        -- Check if it's jog_stop_all or jog_stop
        IF cmd = 'jog_stop_all' THEN
            resp = JOG_STOP_ALL()
            RETURN(TRUE)
        ELSE
            resp = JOG_STOP_H(cmd)
            RETURN(TRUE)
        ENDIF
    ENDIF

    -- if none of the above cmds matched
    WRITE('WRONG COMMAND: ', cmd, CR)
    resp = '1:wrong-command'
    RETURN(TRUE)
END HANDLE_CMD