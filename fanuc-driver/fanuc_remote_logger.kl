-- Description:         Manufacturing Apps
--                      Development Kit (fanuc_remote) 
--                      Driver for FANUC robots.

PROGRAM FANUC_LOG
%STACKSIZE = 4000
%NOLOCKGROUP
%NOPAUSE = ERROR + COMMAND + TPENABLE
%ALPHABETIZE
%COMMENT = 'FANUC_REMOTE LOGGER V0.0.1'

VAR
    comm_file:          FILE
    status:             INTEGER
    entry:              INTEGER
    cmd:                STRING[254]
    resp:               STRING[254]
    keep_conn:          BOOLEAN
    uframe_str:         STRING[3]
    tool_str:           STRING[3]

    -- Global state variables for tool/user/coord selection
    g_tool_num:         INTEGER
    g_uframe_num:       INTEGER
    g_coord_type:       INTEGER  -- 0=WORLD, 1=USER, 2=TOOL

    -- Global jogging state variables
    jog_active:         ARRAY[6] OF BOOLEAN
    jog_dir:            ARRAY[6] OF BOOLEAN
    jog_speed:          INTEGER
    jog_step_lin:       REAL
    jog_step_rot:       REAL
    jog_interval:       INTEGER
    jog_pr:             XYZWPR
    multi_axis:         BOOLEAN
    active_axest:       INTEGER

    -- Time in ms condition handlera
    cont_timer:         INTEGER

CONST
    SERVER_TAG = 7
    PORT_NUMBER = 18736
    UFRAMENUM = 8
    TOOLNUM = 8

-- Include routines
%INCLUDE fanuc_remote_context
%INCLUDE fanuc_remote_utils
%INCLUDE fanuc_remote_comm
%INCLUDE fanuc_remote_jog
%INCLUDE fanuc_remote_cmd

BEGIN -- Begin main program
    -- clear screen
    WRITE('fanuc_remote LOGGER started.', CR)
    
    WHILE TRUE DO
        -- open
        OPEN_COMM(comm_file, SERVER_TAG, PORT_NUMBER)

        keep_conn = TRUE
        WHILE keep_conn DO
            READ comm_file(cmd)
            IF UNINIT(cmd) THEN
                keep_conn = FALSE
            ELSE
                keep_conn = HANDLE_CMD(cmd, resp)

                IF keep_conn THEN
                    WRITE comm_file (resp)
                ELSE
                    WRITE comm_file (resp)
                    READ comm_file(cmd::0)
                ENDIF
            ENDIF
        ENDWHILE
        
        -- disconnect
        CLOSE_COMM(comm_file, SERVER_TAG)
    ENDWHILE -- main listening loop

    WRITE('fanuc_remote LOGGER finished.', CR)
END FANUC_LOG