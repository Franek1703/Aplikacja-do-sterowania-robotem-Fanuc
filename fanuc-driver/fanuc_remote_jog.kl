-- Execute motion to a position
ROUTINE MOVE_TO_POS(POS: XYZWPR; status: INTEGER)
VAR
    -- PR register number for jog motion
    PR_NUM: INTEGER
    entry: INTEGER
    grp_num: INTEGER
BEGIN
    PR_NUM = 81 -- Use the same register as other fanuc_remote operations
    grp_num = 1
    
    -- Set the position register
    SET_POS_REG(PR_NUM, POS, status)
    IF status <> 0 THEN
        RETURN
    ENDIF
    
    -- Set motion parameters
    SET_INT_REG(81, jog_speed, status) -- speed
    SET_INT_REG(82, 100, status)       -- acceleration
    SET_INT_REG(83, 100, status)       -- CNT value for blending
    
    -- Execute motion (using the same TP program as other fanuc_remote operations)
    CALL_PROG('FANUC_REMOTE_MOVEL', status)
END MOVE_TO_POS

-- Get transform from tool frame to world frame
ROUTINE GET_TFRM_WLD: XYZWPR
VAR
    transform: XYZWPR
BEGIN
    -- Get the transformation matrix for the current tool frame
    -- This would typically involve getting the current UTOOL data
    
    -- Placeholder for actual implementation
    transform.x = 0
    transform.y = 0
    transform.z = 0
    transform.w = 0
    transform.p = 0
    transform.r = 0
    
    RETURN(transform)
END GET_TFRM_WLD

-- Get transform from user frame to world frame
ROUTINE GET_UFRM_WLD: XYZWPR
VAR
    transform: XYZWPR
BEGIN
    -- Get the transformation matrix for the current user frame
    -- This would typically involve getting the current UFRAME data
    
    -- Placeholder for actual implementation
    transform.x = 0
    transform.y = 0
    transform.z = 0
    transform.w = 0
    transform.p = 0
    transform.r = 0
    
    RETURN(transform)
END GET_UFRM_WLD


-- Helper routine to transform a delta between coordinate systems
ROUTINE TRANS_DELTA(delta: XYZWPR; transform: XYZWPR): XYZWPR
VAR
    result: XYZWPR
BEGIN
    -- Simplified transformation - in actual implementation would use matrices
    -- This is a placeholder for the actual transformation logic
    
    -- For now we'll just pass through the delta (this needs proper implementation)
    result = delta
    
    RETURN(result)
END TRANS_DELTA


-- Initialize jog module
ROUTINE JOG_INIT
VAR
    i: INTEGER
BEGIN
    -- Initialize jog state
    FOR i = 1 TO 6 DO
        jog_active[i] = FALSE
        jog_dir[i] = TRUE -- Default to positive direction
    ENDFOR
    
    -- Default settings
    jog_speed = 25 -- 25% speed
    jog_step_lin = 0.25 -- 0.25mm per tick for XYZ
    jog_step_rot = 0.5  -- 0.5deg per tick for WPR
    jog_interval = 30   -- 30ms between ticks
    multi_axis = FALSE -- Only one axis at a time (simpler mode)
    active_axest = 0
    
    WRITE('JOG module initialized with default settings', CR)
END JOG_INIT

-- Check if robot is busy with other motion
ROUTINE ROBOT_BUSY: BOOLEAN
VAR
    busy: BOOLEAN
BEGIN
    -- Check robot motion status
    -- This is a placeholder - actual implementation would check robot state
    busy = FALSE
    
    RETURN(busy)
END ROBOT_BUSY

-- Helper functions for converting types to strings (for logging)
ROUTINE I_TO_S(val: INTEGER): STRING
VAR
    s: STRING[10]
BEGIN
    CNV_INT_STR(val, 0, 0, s)
    RETURN(s)
END I_TO_S

ROUTINE R_TO_S(val: REAL): STRING
VAR
    s: STRING[10]
BEGIN
    CNV_REAL_STR(val, 0, 3, s)
    RETURN(s)
END R_TO_S

ROUTINE B_TO_S(val: BOOLEAN): STRING
BEGIN
    IF val THEN
        RETURN('TRUE')
    ELSE
        RETURN('FALSE')
    ENDIF
END B_TO_S

-- Start jogging an axis
ROUTINE JOG_START(axis_idx: INTEGER; direction: BOOLEAN; speed: INTEGER; step_lin: REAL; step_rot: REAL): STRING
VAR
    resp: STRING[254]
    cur_posn: XYZWPR
BEGIN
    -- Check if robot is busy or in fault
    IF ROBOT_BUSY THEN
        resp = '1:ERR BUSY'
        RETURN(resp)
    ENDIF
    
    -- Check if we're allowing multi-axis and if not, check if another axis is active
    IF (NOT multi_axis) AND (active_axest > 0) AND (NOT jog_active[axis_idx]) THEN
        resp = '1:ERR AXIS_ACTIVE'
        RETURN(resp)
    ENDIF
    
    -- Update count of active axes
    IF NOT jog_active[axis_idx] THEN
        active_axest = active_axest + 1
    ENDIF

    -- Set jogging state for this axis
    jog_active[axis_idx] = TRUE
    jog_dir[axis_idx] = direction
    
    -- Update speed if provided
    IF NOT UNINIT(speed) THEN
        IF (speed < 1) OR (speed > 100) THEN
            resp = '1:ERR OUT_OF_RANGE'
            RETURN(resp)
        ENDIF
        jog_speed = speed
    ENDIF
    
    -- Update step sizes if provided
    IF NOT UNINIT(step_lin) THEN
        jog_step_lin = step_lin
    ENDIF
    
    IF NOT UNINIT(step_rot) THEN
        jog_step_rot = step_rot
    ENDIF
    
    -- Initialize working position to current position if this is the first active axis
    IF active_axest = 1 THEN
        cur_posn = CURPOS(0, 0)
        jog_pr = POS(cur_posn.x, cur_posn.y, cur_posn.z, cur_posn.w, cur_posn.p, cur_posn.r, cur_posn.config_data)
    ENDIF
    
    -- Log the start of jogging
    WRITE('JOG_START: Axis ', I_TO_S(axis_idx), ' Direction ', B_TO_S(direction), 
          ' Speed ', I_TO_S(jog_speed), ' Step ', R_TO_S(step_lin), '/', R_TO_S(step_rot), CR)
    
    resp = '0:OK'
    RETURN(resp)
END JOG_START

-- Apply a delta in world coordinates
ROUTINE APPLY_WINC(delta: XYZWPR)
VAR
    new_pos: XYZWPR
BEGIN
    -- Add delta directly to the working position in world coordinates
    new_pos.x = jog_pr.x + delta.x
    new_pos.y = jog_pr.y + delta.y
    new_pos.z = jog_pr.z + delta.z
    new_pos.w = jog_pr.w + delta.w
    new_pos.p = jog_pr.p + delta.p
    new_pos.r = jog_pr.r + delta.r
    
    jog_pr = new_pos
END APPLY_WINC

-- Apply a delta in tool coordinates
ROUTINE APL_INC_TL(delta: XYZWPR)
VAR
    new_pos: XYZWPR
    tool_world: XYZWPR
    world_delta: XYZWPR
BEGIN
    -- Transform delta from tool frame to world frame
    -- This is simplified - in actual implementation would use 
    -- proper coordinate transformation based on active tool frame
    
    -- Get transform from tool frame to world
    tool_world = GET_TFRM_WLD
    
    -- Apply transformation to delta
    world_delta = TRANS_DELTA(delta, tool_world)
    
    -- Apply transformed delta to position
    APPLY_WINC(world_delta)
END APL_INC_TL


-- Apply a delta in user coordinates
ROUTINE APL_INC_USR(delta: XYZWPR)
VAR
    new_pos: XYZWPR
    user_world: XYZWPR
    world_delta: XYZWPR
BEGIN
    -- Transform delta from user frame to world frame
    -- This is simplified - in actual implementation would use 
    -- proper coordinate transformation based on active user frame
    
    -- Get transform from user frame to world
    user_world = GET_UFRM_WLD
    
    -- Apply transformation to delta
    world_delta = TRANS_DELTA(delta, user_world)
    
    -- Apply transformed delta to position
    APPLY_WINC(world_delta)
END APL_INC_USR


-- Stop jogging an axis
ROUTINE JOG_STOP(axis_idx: INTEGER): STRING
VAR
    resp: STRING[254]
BEGIN
    -- Check if the axis is active
    IF jog_active[axis_idx] THEN
        jog_active[axis_idx] = FALSE
        active_axest = active_axest - 1
        
        WRITE('JOG_STOP: Axis ', I_TO_S(axis_idx), CR)
        
        resp = '0:OK'
    ELSE
        resp = '0:OK' -- Still return OK even if not active
    ENDIF
    
    RETURN(resp)
END JOG_STOP


-- Stop all jogging
ROUTINE JOG_STOP_ALL: STRING
VAR
    i: INTEGER
    resp: STRING[254]
BEGIN
    FOR i = 1 TO 6 DO
        jog_active[i] = FALSE
    ENDFOR
    
    active_axest = 0
    WRITE('JOG_STOP_ALL: All axes stopped', CR)
    
    resp = '0:OK'
    RETURN(resp)
END JOG_STOP_ALL


-- Helper function for axis name to index conversion
ROUTINE AXIS2IDX(axis_name: STRING): INTEGER
VAR
    idx: INTEGER
    c   : STRING[1]
BEGIN
    -- Convert axis name to index (1=X, 2=Y, 3=Z, 4=W, 5=P, 6=R)
    c = SUB_STR(axis_name, 1, 1)

    IF (c = 'X') OR (c = 'x') THEN
        idx = 1
    ELSE
        IF (c = 'Y') OR (c = 'y') THEN
            idx = 2
        ELSE
            IF (c = 'Z') OR (c = 'z') THEN
                idx = 3
            ELSE
                IF (c = 'W') OR (c = 'w') THEN
                    idx = 4
                ELSE
                    IF (c = 'P') OR (c = 'p') THEN
                        idx = 5
                    ELSE
                        IF (c = 'R') OR (c = 'r') THEN
                            idx = 6
                        ELSE
                            idx = 0  -- invalid axis
                        ENDIF
                    ENDIF
                ENDIF
            ENDIF
        ENDIF
    ENDIF

    RETURN(idx)
END AXIS2IDX


-- Execute one tick of jog motion if any axes are active
ROUTINE JOG_TICK
VAR
    i: INTEGER
    delta: XYZWPR
    speed_factor: REAL
    status: INTEGER
BEGIN
    -- If no axes are active, do nothing
    IF active_axest = 0 THEN
        RETURN
    ENDIF
    
    -- Apply kinematic context (tool, user frame, coord system)
    APL_KIN_CTX
    
    -- Calculate speed factor (percentage of full speed)
    speed_factor = jog_speed / 100.0
    
    -- Initialize delta to zeros
    delta.x = 0.0
    delta.y = 0.0
    delta.z = 0.0
    delta.w = 0.0
    delta.p = 0.0
    delta.r = 0.0
    
    -- Apply deltas for active axes
    FOR i = 1 TO 6 DO
        IF jog_active[i] THEN
            SELECT i OF
                CASE (1): -- X
                    IF jog_dir[i] THEN
                        delta.x = jog_step_lin * speed_factor
                    ELSE
                        delta.x = -jog_step_lin * speed_factor
                    ENDIF
                CASE (2): -- Y
                    IF jog_dir[i] THEN
                        delta.y = jog_step_lin * speed_factor
                    ELSE
                        delta.y = -jog_step_lin * speed_factor
                    ENDIF
                CASE(3): -- Z
                    IF jog_dir[i] THEN
                        delta.z = jog_step_lin * speed_factor
                    ELSE
                        delta.z = -jog_step_lin * speed_factor
                    ENDIF
                    
                -- Rotational axes use angular step
                CASE(4): -- W
                    IF jog_dir[i] THEN
                        delta.w = jog_step_rot * speed_factor
                    ELSE
                        delta.w = -jog_step_rot * speed_factor
                    ENDIF
                CASE(5): -- P
                    IF jog_dir[i] THEN
                        delta.p = jog_step_rot * speed_factor
                    ELSE
                        delta.p = -jog_step_rot * speed_factor
                    ENDIF
                CASE(6): -- R
                    IF jog_dir[i] THEN
                        delta.r = jog_step_rot * speed_factor
                    ELSE
                        delta.r = -jog_step_rot * speed_factor
                    ENDIF
                ELSE:
                    -- Invalid axis (shouldn't happen)
                    WRITE('JOG_TICK: Invalid axis index: ' + I_TO_S(i), CR)
            ENDSELECT
        ENDIF
    ENDFOR
    
    -- Apply delta based on coordinate system
    SELECT g_coord_type OF
        CASE (0): -- WORLD
            APPLY_WINC(delta)
        CASE (1): -- USER
            APL_INC_USR(delta)
        CASE (2): -- TOOL
            APL_INC_TL(delta)
        ELSE:
            -- Invalid coord type, use WORLD as default
            APPLY_WINC(delta)
    ENDSELECT
    
    -- Execute motion to new position
    MOVE_TO_POS(jog_pr, status)
    
    -- Check for errors
    IF status <> 0 THEN
        WRITE('JOG_TICK: Motion error: ', I_TO_S(status), CR)
    ENDIF
END JOG_TICK