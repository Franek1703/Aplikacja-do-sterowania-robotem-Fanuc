-- Description:         Handles kinematic context
--                      (tool, user frame, coord system)

-- Global state variables defined in mappdk_server.kl
-- g_tool_num:   INTEGER
-- g_uframe_num: INTEGER
-- g_coord_type: INTEGER  -- 0=WORLD, 1=USER, 2=TOOL

ROUTINE APPLY_KINEMATIC_CONTEXT
----------------------------------------------------
-- Function: Applies the current tool, user frame and
--           coordinate system context before any move
----------------------------------------------------
-- Arguments: None
-- Return value: None
----------------------------------------------------
VAR
    status: INTEGER
    entry:  INTEGER
BEGIN
    -- Update $UFRAME and $UTOOL based on global state
    SET_VAR(entry, '*SYSTEM*', '$MNUFRAMENUM[1]', g_uframe_num, status)
    SET_VAR(entry, '*SYSTEM*', '$MNUTOOLNUM[1]', g_tool_num, status)
    
    -- Set coordinate system based on global state
    -- 0=WORLD, 1=USER, 2=TOOL
    CASE g_coord_type OF
        CASE(0):
            -- WORLD coordinates
            SET_VAR(entry, '*SYSTEM*', '$MNCOORDSYS[1]', 0, status)
        CASE(1):
            -- USER coordinates 
            SET_VAR(entry, '*SYSTEM*', '$MNCOORDSYS[1]', 1, status)
        CASE(2):
            -- TOOL coordinates
            SET_VAR(entry, '*SYSTEM*', '$MNCOORDSYS[1]', 2, status)
        ELSE:
            -- Default to WORLD if invalid
            SET_VAR(entry, '*SYSTEM*', '$MNCOORDSYS[1]', 0, status)
    ENDCASE
END APPLY_KINEMATIC_CONTEXT