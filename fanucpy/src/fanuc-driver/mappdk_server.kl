-- Description:         Manufacturing Apps
--                      Development Kit (MAPPDK) 
--                      Driver for FANUC robots.
PROGRAM MAPPDK_SVR
%STACKSIZE = 4000
%NOLOCKGROUP
%NOPAUSE = ERROR + COMMAND + TPENABLE
%ALPHABETIZE
%COMMENT = 'MAPPDK SERVER V0.0.1'

VAR
    comm_file:          FILE
    status:             INTEGER
    entry:              INTEGER
    cmd:                STRING[254]
    resp:               STRING[254]
    keep_conn:          BOOLEAN
    uframe_str:         STRING[1]
    tool_str:           STRING[1]
    
-- Global state variables for tool/user/coord selection
    g_tool_num:         INTEGER
    g_uframe_num:       INTEGER
    g_coord_type:       INTEGER  -- 0=WORLD, 1=USER, 2=TOOL
    
CONST
    SERVER_TAG = 8
    PORT_NUMBER = 18735
    UFRAMENUM = 8
    TOOLNUM = 8


-- Include routines
%INCLUDE mappdk_utils
%INCLUDE mappdk_comm
%INCLUDE mappdk_cmd
%INCLUDE mappdk_context
%INCLUDE mappdk_jog

-- Jog tick task declaration
ROUTINE JOG_TICK_TASK
VAR
    start_time: INTEGER
    end_time: INTEGER
    delay_time: INTEGER
    interval: INTEGER
BEGIN
    -- Default interval in milliseconds
    interval = jog_interval
    
    WHILE TRUE DO
        -- Record start time
        start_time = GETTIME(0)
        
        -- Execute one tick of jogging
        JOG_TICK
        
        -- Calculate elapsed time
        end_time = GETTIME(0)
        delay_time = interval - (end_time - start_time)
        
        -- Sleep until next interval (ensuring a minimum of 1ms delay)
        IF delay_time < 1 THEN
            delay_time = 1
        ENDIF
        DELAY delay_time
    ENDWHILE
END JOG_TICK_TASK

BEGIN -- Begin main program
    -- clear screen
    TP_CLS
    WRITE('MAPPDK SERVER started.', CR)

    -- Initialize global state variables
    g_tool_num = TOOLNUM
    g_uframe_num = UFRAMENUM
    g_coord_type = 0  -- Default to WORLD coordinates
    
    -- Initialize jog module
    JOG_INIT
    
    -- set userframe and toolframe
    -- !!!TO BE DOCUMENTED!!!
    SET_VAR(entry, '*SYSTEM*', '$MNUFRAMENUM[1]', g_uframe_num, status)
    SET_VAR(entry, '*SYSTEM*', '$MNUTOOLNUM[1]', g_tool_num, status)
    
    -- Start jog tick task
    CONNECT TIMER[1] TO JOG_TICK_TASK
    SET_CYCLES(TIMER[1], 0) -- Run continuously
    SET_TIMER_TYPE(TIMER[1], 2) -- Semi-adaptive task
    RUN_TIMER(TIMER[1], jog_interval) -- Start with jog interval

    -- update $UFRAME and $UTOOL
    CNV_INT_STR(UFRAMENUM, 1, 0, uframe_str)
    CNV_INT_STR(TOOLNUM, 1, 0, tool_str)
    GET_VAR(entry, '*SYSTEM*', '$MNUFRAME[1, ' + uframe_str + ']', $GROUP[1].$UFRAME, status)
    GET_VAR(entry, '*SYSTEM*', '$MNUTOOL[1, ' + tool_str + ']', $GROUP[1].$UTOOL, status)
    
    WHILE TRUE DO
        -- open
        OPEN_COMM(comm_file, SERVER_TAG, PORT_NUMBER)
        
        keep_conn = TRUE
        WHILE keep_conn DO
            READ comm_file(cmd)
            IF UNINIT(cmd) THEN
                keep_conn = FALSE
            ELSE
                keep_conn = HANDLE_CMD(cmd, resp)

                IF keep_conn THEN
                    WRITE comm_file (resp)
                ELSE
                    WRITE comm_file (resp)
                    READ comm_file(cmd::0)
                ENDIF
            ENDIF
        ENDWHILE
        
        -- disconnect
        CLOSE_COMM(comm_file, SERVER_TAG)
    ENDWHILE -- main listening loop

    WRITE('MAPPDK SERVER finished.', CR)
END MAPPDK_SVR